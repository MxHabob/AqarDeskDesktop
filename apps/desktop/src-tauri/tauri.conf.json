{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AqarDesk Desktop",
  "identifier": "com.mulverse.aqardesk.desktop",
  "version": "1.0.5",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:1520",
    "beforeDevCommand": "cd ../web && bun run dev",
    "beforeBuildCommand": "cd ../web && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AqarDesk",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "focus": true,
        "skipTaskbar": false
      }
    ],

    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'self' blob:",
        "form-action": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'self' asset: blob:",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,

      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/AqarDesk/**",
          "$LOCALAPPDATA/AqarDesk/**",
          "$RESOURCE/**"
        ]
      },

      "capabilities": [
        "default",
        "desktop-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "release-notes.json"
    ],
    "macOS": {
      "dmg": {
        "background": "./images/installer.png"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "sidebarImage": "./images/aqardesk-installer-sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
