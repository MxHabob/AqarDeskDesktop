{
  "name": "aqardesk-desktop",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --continue",
    "build": "turbo run build --continue",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "dev:web": "turbo run dev --filter=web",
    "build:web": "turbo run build --filter=web",
    "check:web": "turbo run check --filter=web",
    "rename:web-components": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rename-web-components.ps1 -Apply",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test scripts/prepare-release.test.mjs scripts/release-artifacts.test.mjs",
    "desktop:dev": "bun run --cwd apps/desktop tauri:dev",
    "desktop:build": "bun run --cwd apps/desktop tauri:build",
    "dev:api": "cargo run --manifest-path backend/api/Cargo.toml",
    "check:backend": "cargo check --workspace --manifest-path Cargo.toml",
    "test:backend": "cargo test --workspace --manifest-path Cargo.toml",
    "generate:sdk": "cargo run --manifest-path backend/api/Cargo.toml -- --export-openapi backend/api/openapi.json && bun run --cwd packages/sdk generate",
    "lint:all": "turbo run check --filter=web && cargo check --workspace --manifest-path Cargo.toml"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
