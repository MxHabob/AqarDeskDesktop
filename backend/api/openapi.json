  "components": {
    "schemas": {
      "DashboardSummary": {
        "type": "object",
        "required": [
          "active_properties_count",
          "units_count",
          "available_units_count",
          "tenants_count",
          "active_leases_count",
          "open_charges_count",
          "posted_payments_count",
          "contract_documents_count",
          "expiring_leases_count",
          "payment_months",
          "monthly_payments",
          "unit_status_counts",
          "lease_status_counts",
          "open_charges_by_currency"
        ],
        "properties": {
          "active_leases_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "active_properties_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "available_units_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "contract_documents_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "expiring_leases_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "lease_status_counts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusCount"
            }
          },
          "monthly_payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthlyPayment"
            }
          },
          "open_charges_by_currency": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpenChargesByCurrency"
            }
          },
          "open_charges_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "payment_months": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "posted_payments_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tenants_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "unit_status_counts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusCount"
            }
          },
          "units_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "HealthPayload": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "MonthlyPayment": {
        "type": "object",
        "required": [
          "month",
          "currency_code",
          "currency_decimal_digits",
          "amount_minor",
          "payment_count"
        ],
        "properties": {
          "amount_minor": {
            "type": "integer",
            "format": "int64"
          },
          "currency_code": {
            "type": "string"
          },
          "currency_decimal_digits": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "string"
          },
          "payment_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "OpenChargesByCurrency": {
        "type": "object",
        "required": [
          "currency_code",
          "currency_decimal_digits",
          "amount_minor",
          "charge_count"
        ],
        "properties": {
          "amount_minor": {
            "type": "integer",
            "format": "int64"
          },
          "charge_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency_code": {
            "type": "string"
          },
          "currency_decimal_digits": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "OperationResult": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "Property": {
        "type": "object",
        "required": [
          "id",
          "organization_id",
          "code",
          "name",
          "property_type",
          "address_line_1",
          "city",
          "country_code",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "address_line_1": {
            "type": "string"
          },
          "address_line_2": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organization_id": {
            "type": "string"
          },
          "postal_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "property_type": {
            "$ref": "#/components/schemas/PropertyType"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/PropertyStatus"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "PropertyInput": {
        "type": "object",
        "required": [
          "code",
          "name",
          "property_type",
          "address_line_1",
          "city",
          "country_code",
          "status"
        ],
        "properties": {
          "address_line_1": {
            "type": "string"
          },
          "address_line_2": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "postal_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "property_type": {
            "$ref": "#/components/schemas/PropertyType"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/PropertyStatus"
          }
        }
      },
      "PropertyStatus": {
        "type": "string",
        "enum": [
          "active",
          "inactive",
          "archived"
        ]
      },
      "PropertyType": {
        "type": "string",
        "enum": [
          "residential",
          "commercial",
          "mixed_use",
          "land",
          "other"
        ]
      },
      "PropertyUnit": {
        "type": "object",
        "required": [
          "id",
          "organization_id",
          "property_id",
          "unit_number",
          "unit_type",
          "bedrooms",
          "bathrooms",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "area_square_meters": {
            "type": [
              "number",
              "null"
            ],
